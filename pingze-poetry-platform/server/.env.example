# ============================================
# 平仄间 (PingZe Jian) - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# 数据库配置 (AnalyticDB PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pingze_poetry
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT 密钥 (请使用强随机字符串)
JWT_SECRET=your_jwt_secret_key_here

# 服务器端口
PORT=3001
